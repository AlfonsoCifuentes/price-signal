{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'sha256-Du+OJKJSbdUgz5nrHeWWINvez6XKDDU/tyj/5c2uvwo='; style-src 'self'; img-src 'self' data:; font-src 'self'; media-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'"
        }
      ]
    },
    {
      "source": "/public/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/public/media/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    },
    {
      "source": "/public/(data|downloads)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/public/media/price-signal-film.mp4",
      "destination": "/public/media/pricing-demo-horizontal-en.mp4",
      "permanent": true
    },
    {
      "source": "/public/media/price-signal-film-es.mp4",
      "destination": "/public/media/pricing-demo-horizontal-es.mp4",
      "permanent": true
    },
    {
      "source": "/public/media/price-signal-vertical.mp4",
      "destination": "/public/media/pricing-demo-vertical-en.mp4",
      "permanent": true
    },
    {
      "source": "/public/media/price-signal-vertical-es.mp4",
      "destination": "/public/media/pricing-demo-vertical-es.mp4",
      "permanent": true
    },
    {
      "source": "/public/media/price-signal-film.en.vtt",
      "destination": "/public/media/pricing-demo-horizontal-en.vtt",
      "permanent": true
    },
    {
      "source": "/public/media/price-signal-film.es.vtt",
      "destination": "/public/media/pricing-demo-horizontal-es.vtt",
      "permanent": true
    },
    {
      "source": "/public/media/og-cover.png",
      "destination": "/public/media/og-pricing-demo-en.png",
      "permanent": true
    },
    {
      "source": "/public/media/og-cover-es.png",
      "destination": "/public/media/og-pricing-demo-es.png",
      "permanent": true
    },
    {
      "source": "/public/media/film-poster.jpg",
      "destination": "/public/media/poster-horizontal-en.jpg",
      "permanent": true
    },
    {
      "source": "/public/media/film-poster-es.jpg",
      "destination": "/public/media/poster-horizontal-es.jpg",
      "permanent": true
    },
    {
      "source": "/public/downloads/PRICE_SIGNAL_Public_Case_EN.pdf",
      "destination": "/public/downloads/Pricing_Demo_Case_Study_EN.pdf",
      "permanent": true
    },
    {
      "source": "/public/downloads/PRICE_SIGNAL_Caso_Publico_ES.pdf",
      "destination": "/public/downloads/Pricing_Demo_Caso_de_Estudio_ES.pdf",
      "permanent": true
    },
    {
      "source": "/public/downloads/PRICE_SIGNAL_Public_Case_EN.pptx",
      "destination": "/public/downloads/Pricing_Demo_Case_Study_EN.pptx",
      "permanent": true
    },
    {
      "source": "/public/downloads/PRICE_SIGNAL_Caso_Publico_ES.pptx",
      "destination": "/public/downloads/Pricing_Demo_Caso_de_Estudio_ES.pptx",
      "permanent": true
    },
    {
      "source": "/public/downloads/PRICE_SIGNAL_Independent_Synthetic_Analysis.xlsx",
      "destination": "/public/downloads/Pricing_Demo_Analysis_Workbook.xlsx",
      "permanent": true
    },
    {
      "source": "/public/downloads/Alfonso-Cifuentes-CV-EN.pdf",
      "destination": "https://alfonsocifuentes.vercel.app/",
      "permanent": false
    },
    {
      "source": "/public/downloads/Alfonso-Cifuentes-CV-ES.pdf",
      "destination": "https://alfonsocifuentes.vercel.app/",
      "permanent": false
    },
    {
      "source": "/public/downloads/Alfonso-Cifuentes-Cover-Letter-EN.pdf",
      "destination": "https://alfonsocifuentes.vercel.app/",
      "permanent": false
    },
    {
      "source": "/public/downloads/Alfonso-Cifuentes-Carta-ES.pdf",
      "destination": "https://alfonsocifuentes.vercel.app/",
      "permanent": false
    }
  ]
}